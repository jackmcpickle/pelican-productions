---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import FAQAccordion from '@/components/content/FAQAccordion.astro';
import Button from '@/components/ui/Button.astro';

const faqs = (await getCollection('faq')).sort(
    (a, b) => a.data.order - b.data.order,
);

const faqItems = faqs.map(faq => ({
    question: faq.data.question,
    answer: faq.data.answer,
}));
---

<BaseLayout
    title="FAQ"
    description="Frequently asked questions about Pelican Productions"
>
    <section class="py-20">
        <div class="mx-auto max-w-3xl px-4">
            <SectionHeading
                title="Frequently Asked Questions"
                subtitle="Find answers to common questions about our programs"
            />

            <FAQAccordion items={faqItems} />

            <div class="bg-pelican-teal/10 mt-16 rounded-xl p-8 text-center">
                <h3 class="text-xl font-bold text-gray-900">
                    Still have questions?
                </h3>
                <p class="mt-2 text-gray-600">
                    We're here to help! Reach out and we'll get back to you as
                    soon as possible.
                </p>
                <div class="mt-6">
                    <Button href="/contact">Contact Us</Button>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
