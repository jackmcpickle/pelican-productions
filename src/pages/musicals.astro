---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
    MusicalsCredits,
    MusicalsCta,
    MusicalsGallery,
    MusicalsHero,
    MusicalsShows,
} from '@/modules/musicals';
import { musicalsMeta } from '@/data/musicals';
---

<BaseLayout
    title={musicalsMeta.title}
    description={musicalsMeta.description}
    active="musicals"
>
    <MusicalsHero />
    <MusicalsGallery />
    <MusicalsShows />
    <MusicalsCredits />
    <MusicalsCta />
</BaseLayout>
