---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import DateRow from '@/components/ui/DateRow.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import StatCard from '@/components/ui/StatCard.astro';
import {
    cert4AuditionPieces,
    cert4AuditionUrl,
    cert4Curriculum,
    cert4Dates,
    cert4Facts,
    cert4Mentors,
    cert4Meta,
    cert4ProspectusUrl,
    cert4Reasons,
    diplomaInterestUrl,
} from '@/data/cert4';
---

<BaseLayout title={cert4Meta.title} description={cert4Meta.description}>
    <Section class="mt-12 md:mt-16">
        <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
            <div class="flex flex-col gap-6">
                <Badge>Auditions extended to 30 August</Badge>
                <Heading as="h1" size="hero" class="md:text-[80px]">
                    Cert IV Musical Theatre
                </Heading>
                <p class="text-body m-0">
                    CUA40520 · with Empowerdance RTO 40397
                </p>
            </div>
            <div class="flex flex-col gap-6 text-body">
                <p class="m-0">
                    For the first time in South Australia, aspiring musical
                    theatre performers can enrol in the CUA40520 Certificate IV
                    in Musical Theatre through Pelican. One academic year at The
                    Nest, led by Jen Frith and Kylie Green.
                </p>
                <p class="m-0">
                    Built for students in Years 10–13 who want serious training
                    in singing, acting and dance, plus an audition portfolio
                    and the credits to match.
                </p>
                <div class="flex flex-wrap gap-3">
                    <Button href={cert4AuditionUrl} target="_blank" rel="noopener noreferrer">
                        Submit your audition
                    </Button>
                    <Button
                        href={cert4ProspectusUrl}
                        variant="secondary"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Course prospectus
                    </Button>
                </div>
            </div>
        </div>
    </Section>

    <Section class="mt-16 md:mt-20">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
                cert4Facts.map((fact, index) => (
                    <StatCard
                        label={fact.label}
                        value={fact.value}
                        variant={index === 3 ? 'violet' : 'flame'}
                    />
                ))
            }
        </div>
    </Section>

    <Section class="mt-16 md:mt-20">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {
                cert4Reasons.map((reason) => (
                    <Card variant="cream" class="flex flex-col gap-4">
                        <Heading as="h2" size="card">
                            {reason.title}
                        </Heading>
                        <p class="text-body m-0">{reason.body}</p>
                    </Card>
                ))
            }
        </div>
    </Section>

    <Section class="mt-16 md:mt-20">
        <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
            <Heading as="h2" size="display">What you'll learn</Heading>
            <ul class="m-0 flex list-none flex-col gap-3 p-0">
                {
                    cert4Curriculum.map((item) => (
                        <li class="border-ink-dotted border-t-[1.5px] pt-3 text-body">
                            {item}
                        </li>
                    ))
                }
            </ul>
        </div>
    </Section>

    <Section class="mt-16 md:mt-20">
        <Heading as="h2" size="display" class="mb-8">Meet your mentors</Heading>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                cert4Mentors.map((mentor) => (
                    <Card variant="cream" class="flex flex-col gap-3">
                        <Heading as="h3" size="card">
                            {mentor.name}
                        </Heading>
                        <span class="text-sm leading-snug">{mentor.credit}</span>
                    </Card>
                ))
            }
        </div>
    </Section>

    <Section class="mt-16 md:mt-20">
        <Card variant="ink" class="relative overflow-hidden">
            <Halftone />
            <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-16">
                <div class="flex flex-col gap-6">
                    <Badge>2027 intake</Badge>
                    <Heading as="h2" size="display" class="text-white">
                        How to audition
                    </Heading>
                    <p class="text-body m-0 text-white">
                        Submit an online audition video. Full instructions sit
                        on page 23 of the course prospectus.
                    </p>
                    <div class="flex flex-col">
                        {
                            cert4Dates.map((date) => (
                                <DateRow when={date.when} what={date.what} />
                            ))
                        }
                    </div>
                    <Button
                        href={cert4AuditionUrl}
                        variant="outline-light"
                        class="self-start"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Submit your audition
                    </Button>
                </div>
                <div class="flex flex-col gap-4">
                    {
                        cert4AuditionPieces.map((piece) => (
                            <Card variant="cream" class="flex flex-col gap-3 p-6">
                                <Heading as="h3" size="small">
                                    {piece.title}
                                </Heading>
                                <p class="text-body m-0">{piece.detail}</p>
                                {piece.href && piece.cta && (
                                    <Button
                                        href={piece.href}
                                        variant="secondary"
                                        class="self-start"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        {piece.cta}
                                    </Button>
                                )}
                            </Card>
                        ))
                    }
                </div>
            </div>
        </Card>
    </Section>

    <Section class="mt-16 md:mt-20">
        <Card variant="violet" class="relative overflow-hidden">
            <Halftone />
            <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-16">
                <div class="flex flex-col gap-6">
                    <Badge>Launching 2027</Badge>
                    <Heading as="h2" size="display" class="text-white">
                        Diploma of Musical Theatre
                    </Heading>
                </div>
                <div class="flex flex-col gap-6 text-body">
                    <p class="m-0">
                        CUA50220, also with Empowerdance RTO 40397. Full-time
                        professional training, Tuesday to Friday, for
                        post-school performers. More information coming soon.
                    </p>
                    <Button
                        href={diplomaInterestUrl}
                        variant="outline-light"
                        class="self-start"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Register your interest
                    </Button>
                </div>
            </div>
        </Card>
    </Section>
</BaseLayout>
