---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { siteInfo, socialLinks } from '@/data/site';

const facebookHref =
    socialLinks.find((link) => link.label === 'Facebook')?.href ?? '#';
---

<BaseLayout
    title="Contact"
    description="Get in touch with Pelican Productions about programs, events, bookings or the Sing!OZ waitlist."
>
    <Section class="mt-12 md:mt-16">
        <div class="grid items-start gap-10 md:grid-cols-[1fr_2fr] md:gap-16">
            <div class="flex flex-col gap-6">
                <Badge>The Nest · Mitcham</Badge>
                <Heading as="h1" size="hero" class="md:text-[80px]">
                    Contact
                </Heading>
                <Card variant="cream" class="flex flex-col gap-4">
                    <Heading as="h2" size="small">Details</Heading>
                    <div class="text-body flex flex-col gap-2">
                        <p class="m-0">
                            <a href={`tel:${siteInfo.phone.replace(/\s/g, '')}`}
                                >{siteInfo.phone}</a
                            >
                        </p>
                        <p class="m-0">
                            <a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a>
                        </p>
                        <p class="m-0 mt-2">{siteInfo.nestAddress}</p>
                    </div>
                    <Button
                        href={facebookHref}
                        variant="secondary"
                        class="self-start"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Facebook
                    </Button>
                </Card>
            </div>
            <ContactForm
                heading="Send us a message"
                description="Programs, bookings, Sing!OZ waitlist, or anything else. We'll get back to you."
            />
        </div>
    </Section>
</BaseLayout>
