---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import Section from '@/components/ui/Section.astro';
import { portalUrl } from '@/data/site';

const programs = [
    {
        name: 'Music Theatre Academy',
        ages: '7–18yrs · three age groups',
        times: [
            'Fridays 4.30–8.00pm (8–18yrs, incl. 30min dinner break)',
            'Saturdays 9.30am–12.30pm (7–18yrs)',
        ],
        blurb: 'Build your skills as a triple threat in dance, voice and acting for musical theatre. Students rotate through an hour each of vocal, acting and dance every week — three classes on one night, in one location.',
        more: 'Resident tutors bring a wealth of teaching and performance experience, with special guests covering vocal technique, cabaret and audition technique. Excursions to music theatre productions plus a mid-year and end-of-year showcase.',
        cta: 'Register for Term 3, 2026',
    },
    {
        name: 'Vocal Academy',
        ages: '7yrs+ · private lessons',
        times: [
            'Mondays, Tuesdays, Thursdays',
            'Lesson times between 3.30 & 8.00pm',
        ],
        blurb: 'Private 30-minute personalised vocal lessons with acclaimed teachers Jemma Allen, Kylie Green and Michael Griffiths.',
        more: 'Bookings are now open for lessons in 2026.',
        cta: 'Book a lesson',
    },
    {
        name: 'SMASH Dance',
        ages: '7–17yrs · recreational',
        times: [
            'Level 1 — Tuesdays 5.15–6.00pm (7–11yrs)',
            'Level 2 — Tuesdays 4.15–5.15pm (12–17yrs)',
        ],
        blurb: 'Learn fresh choreography each week in an upbeat, welcoming class that builds strong dance technique while keeping the focus on fun.',
        more: 'No competitions, no concerts. Just great music, great energy and a supportive space to dance your heart out.',
        cta: 'Register for Term 3, 2026',
    },
    {
        name: 'Acting',
        ages: '7–17yrs · two groups',
        times: [
            'Tuesdays 4.30–5.15pm (7–11yrs)',
            'Tuesdays 5.15–6.15pm (12–17yrs)',
        ],
        blurb: 'Explore a wide range of theatrical styles, scene work and camera work — acting technique, vocal development, comic and dramatic timing, improvisation.',
        more: "Voice and body integration (the actor's instrument) for stage and screen performance.",
        cta: 'Register for Term 3, 2026',
    },
];
---

<BaseLayout
    title="The Nest | Pelican Productions"
    description="The Nest is the home of Pelican Productions and a creative arts precinct in Lower Mitcham."
    active="nest"
>
    <Section class="mt-12 md:mt-16">
        <MediaFrame
            src="https://www.pelicanproductions.com.au/uploads/3/9/5/6/39560363/thenest-banner_orig.jpg"
            alt="The Nest studio"
            class="h-[min(520px,70vh)] bg-violet"
        >
            <div
                class="absolute inset-x-6 bottom-6 flex flex-col gap-6 sm:inset-x-10 sm:bottom-10 md:flex-row md:items-end md:justify-between"
            >
                <div class="flex flex-col gap-4">
                    <Badge>Weekly classes · Term 3, 2026 enrolling</Badge>
                    <Heading as="h1" size="hero" class="text-white">
                        The Nest
                    </Heading>
                </div>
                <p class="m-0 text-right text-base leading-snug text-white">
                    57A Price Avenue<br />Mitcham SA
                </p>
            </div>
        </MediaFrame>
    </Section>

    <Section class="mt-16 md:mt-20">
        <div
            class="grid items-start gap-10 md:grid-cols-2 md:gap-16"
        >
            <Heading
                as="h2"
                size="section"
                class="leading-[1.1] md:text-[80px]"
            >
                A class for every kind of performer
            </Heading>
            <div class="flex flex-col gap-6 text-body">
                <p class="m-0">
                    Whether you're building skills towards a professional
                    career in the performing arts or simply want lots of fun
                    with friends in an inclusive, inspiring environment, we've
                    got you. The Nest is home to a dedicated Music Theatre
                    Academy, SMASH dance, acting classes, private vocal lessons
                    and our adult community choir.
                </p>
                <p class="m-0">
                    Tutors are working industry professionals. Sports Vouchers
                    Plus are accepted on every program.
                </p>
                <Button href={portalUrl} class="self-start">
                    Register for Term 3, 2026
                </Button>
            </div>
        </div>
    </Section>

    <Section class="mt-20 md:mt-24">
        <div class="flex flex-col gap-4">
            {
                programs.map((program) => (
                    <Card variant="cream">
                        <div class="grid items-start gap-8 md:grid-cols-[1fr_1.4fr] md:gap-10">
                            <div class="flex flex-col gap-4">
                                <Badge tone="sun" class="self-start text-xs">
                                    {program.ages}
                                </Badge>
                                <Heading as="h3" size="card" class="md:text-[64px]">
                                    {program.name}
                                </Heading>
                                <div class="flex flex-col gap-1">
                                    {program.times.map((time) => (
                                        <span class="text-sm leading-snug">
                                            {time}
                                        </span>
                                    ))}
                                </div>
                            </div>
                            <div class="flex flex-col gap-5 text-body">
                                <p class="m-0">{program.blurb}</p>
                                <p class="m-0">{program.more}</p>
                                <Button href={portalUrl} class="self-start">
                                    {program.cta}
                                </Button>
                            </div>
                        </div>
                    </Card>
                ))
            }
        </div>
    </Section>

    <Section class="mt-20 md:mt-24">
        <Card variant="violet" class="relative overflow-hidden">
            <Halftone />
            <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-10">
                <div class="flex flex-col gap-6">
                    <Badge>Adults 18+ · No audition required</Badge>
                    <Heading as="h2" size="display">
                        Sing!OZ<br />adult choir
                    </Heading>
                    <Button variant="outline-light" class="self-start">
                        2026 program filled — waitlist for 2027
                    </Button>
                </div>
                <div class="flex flex-col gap-4 text-body">
                    <p class="m-0">
                        For all those who have ever said "I wish there was
                        something like this when I was young." Well, now there
                        is. Harmony singing, vocal technique and a cracking
                        repertoire — you don't need to be an accomplished
                        singer, all you need is a love to sing.
                    </p>
                    <p class="m-0">
                        Tuesdays 7–9pm, Lower Mitcham, school terms 2 & 3. $330
                        per ten-week term (Term 2 $360, includes t-shirt).
                        Final concert Saturday 24 October at Norwood Concert
                        Hall, backed by a live band.
                    </p>
                </div>
            </div>
        </Card>
    </Section>
</BaseLayout>
