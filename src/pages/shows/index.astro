---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ShowCard from '@/components/content/ShowCard.astro';

const allShows = await getCollection('shows');
const upcomingShows = allShows.filter(show => show.data.status === 'upcoming');
const pastShows = allShows.filter(show => show.data.status === 'past');
---

<BaseLayout
    title="Shows"
    description="See our upcoming and past productions"
>
    <section class="py-20">
        <div class="mx-auto max-w-7xl px-4">
            <SectionHeading
                title="Our Productions"
                subtitle="Experience the magic of live theatre"
            />

            {
                upcomingShows.length > 0 && (
                    <>
                        <h3 class="mb-8 text-2xl font-bold text-gray-900">
                            Upcoming Shows
                        </h3>
                        <div class="mb-16 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                            {upcomingShows.map(show => (
                                <ShowCard
                                    title={show.data.title}
                                    date={show.data.date}
                                    description={show.data.description}
                                    image={show.data.image}
                                    slug={show.slug}
                                    status={show.data.status}
                                />
                            ))}
                        </div>
                    </>
                )
            }

            {
                pastShows.length > 0 && (
                    <>
                        <h3 class="mb-8 text-2xl font-bold text-gray-900">
                            Past Productions
                        </h3>
                        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                            {pastShows.map(show => (
                                <ShowCard
                                    title={show.data.title}
                                    date={show.data.date}
                                    description={show.data.description}
                                    image={show.data.image}
                                    slug={show.slug}
                                    status={show.data.status}
                                />
                            ))}
                        </div>
                    </>
                )
            }
        </div>
    </section>
</BaseLayout>
