---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import {
    ProductionCredits,
    ProductionGallery,
    ProductionHero,
    ProductionReviews,
    MusicalsCta,
} from '@/modules/musicals';
import { siteInfo } from '@/data/site';
import {
    getProductionBySlug,
    getProductionPages,
} from '@/lib/productions';

export const prerender = true;

export async function getStaticPaths(): Promise<{ params: { slug: string } }[]> {
    const productions = await getProductionPages();
    return productions.map((production) => ({
        params: { slug: production.id },
    }));
}

const production = await getProductionBySlug(Astro.params.slug);

if (!production) {
    throw new Error('Production not found');
}

const { data } = production;
const { Content } = await render(production);
const description =
    data.description ??
    `Pelican Productions' ${data.year} production of ${data.name}.`;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'TheaterEvent',
    name: data.name,
    description,
    startDate: String(data.year),
    eventStatus: 'https://schema.org/EventScheduled',
    organizer: {
        '@type': 'Organization',
        name: siteInfo.name,
        url: siteInfo.url,
    },
    location: data.venue
        ? {
              '@type': 'Place',
              name: data.venue,
          }
        : {
              '@type': 'Place',
              address: {
                  '@type': 'PostalAddress',
                  addressRegion: 'SA',
                  addressCountry: 'AU',
              },
          },
    image: data.coverImage,
    review: data.reviews?.map(
        (review: { quote: string; attribution: string }) => ({
            '@type': 'Review',
            reviewBody: review.quote,
            author: {
                '@type': 'Person',
                name: review.attribution,
            },
        }),
    ),
};
---

<BaseLayout title={data.name} description={description} active="musicals">
    <Fragment slot="head">
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    </Fragment>
    <ProductionHero
        name={data.name}
        year={data.year}
        note={data.note}
        venue={data.venue}
        coverImage={data.coverImage}
        awards={data.awards}
    />
    {
        production.body?.trim() && (
            <Section>
                <article
                    class="prose max-w-3xl text-ink prose-headings:font-display prose-headings:font-normal prose-headings:text-ink prose-headings:tracking-[0.02em] prose-p:text-ink/80 prose-a:text-flame prose-a:no-underline hover:prose-a:text-ink prose-strong:text-ink prose-li:text-ink/80"
                >
                    <Content />
                </article>
            </Section>
        )
    }
    {data.reviews && <ProductionReviews items={data.reviews} />}
    {
        data.credits && (
            <ProductionCredits items={data.credits} />
        )
    }
    {data.gallery && <ProductionGallery items={data.gallery} />}
    <MusicalsCta />
</BaseLayout>
