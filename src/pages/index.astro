---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeHero from '@/components/home/HomeHero.astro';
import HomeTicker from '@/components/home/HomeTicker.astro';
import HomeWhatsOn from '@/components/home/HomeWhatsOn.astro';
import HomeStats from '@/components/home/HomeStats.astro';
import HomePrograms from '@/components/home/HomePrograms.astro';
import HomeCamps from '@/components/home/HomeCamps.astro';
import HomeShows from '@/components/home/HomeShows.astro';
import HomeSingOz from '@/components/home/HomeSingOz.astro';
import HomeAbout from '@/components/home/HomeAbout.astro';
import { homeMeta } from '@/data/home';
---

<BaseLayout
    title={homeMeta.title}
    description={homeMeta.description}
    active=""
>
    <HomeHero />
    <HomeTicker />
    <HomeWhatsOn />
    <HomeStats />
    <HomePrograms />
    <HomeCamps />
    <HomeShows />
    <HomeSingOz />
    <HomeAbout />
</BaseLayout>
