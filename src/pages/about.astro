---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
    AboutCtas,
    AboutDirectors,
    AboutHero,
    AboutStory,
    AboutValues,
} from '@/modules/about';
import { aboutMeta } from '@/data/about';
---

<BaseLayout
    title={aboutMeta.title}
    description={aboutMeta.description}
    active="about"
>
    <AboutHero />
    <AboutStory />
    <AboutValues />
    <AboutDirectors />
    <AboutCtas />
</BaseLayout>
