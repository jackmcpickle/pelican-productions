---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Section from '@/components/ui/Section.astro';
import GalleryGrid from '@/components/blocks/GalleryGrid.astro';
import FaqList from '@/components/blocks/FaqList.astro';
import TestimonialsGrid from '@/components/blocks/TestimonialsGrid.astro';
import ContactForm from '@/components/blocks/ContactForm.astro';
import TeamGrid from '@/components/blocks/TeamGrid.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import { siteInfo } from '@/data/site';
import { RESERVED_SLUGS } from '@/lib/pages';

export const prerender = true;

export async function getStaticPaths(): Promise<{ params: { slug: string } }[]> {
    const pages = await getCollection('pages');
    return pages
        .filter((page: CollectionEntry<'pages'>) => !RESERVED_SLUGS.has(page.id))
        .map((page: CollectionEntry<'pages'>) => ({
            params: { slug: page.id },
        }));
}

const slug = Astro.params.slug;
const pages = await getCollection('pages');
const page = pages.find(
    (entry: CollectionEntry<'pages'>) => entry.id === slug,
);

if (!page) {
    throw new Error('Page not found');
}

const { Content } = await render(page);
const pageData = page.data;
---

<BaseLayout title={pageData.title} description={pageData.description}>
    <PageHero
        title={pageData.hero?.title ?? pageData.title}
        subtitle={pageData.hero?.subtitle}
        image={pageData.hero?.image}
    />
    <Section>
        <article
            class="prose max-w-none text-ink prose-headings:font-display prose-headings:font-normal prose-headings:text-ink prose-headings:tracking-[0.02em] prose-p:text-ink/80 prose-a:text-flame prose-a:no-underline hover:prose-a:text-ink prose-strong:text-ink prose-li:text-ink/80"
        >
            <Content />
        </article>
    </Section>
    {
        pageData.gallery && (
            <Section title="Gallery">
                <GalleryGrid items={pageData.gallery} />
            </Section>
        )
    }
    {
        pageData.faqs && (
            <Section title="FAQ">
                <FaqList items={pageData.faqs} />
            </Section>
        )
    }
    {
        pageData.testimonials && (
            <Section title="Testimonials">
                <TestimonialsGrid items={pageData.testimonials} />
            </Section>
        )
    }
    {
        pageData.team && (
            <Section title="Team">
                <TeamGrid groups={pageData.team} />
            </Section>
        )
    }
    {
        pageData.contact && (
            <Section title="Contact Details">
                <div class="grid gap-6 md:grid-cols-[1fr_2fr]">
                    <Card variant="cream" class="text-body max-w-none">
                        <Heading as="h3" size="small">
                            Get in touch
                        </Heading>
                        <div class="mt-4 flex flex-col gap-2">
                            <p class="m-0">Phone: {siteInfo.phone}</p>
                            <p class="m-0">Email: {siteInfo.email}</p>
                            <p class="m-0 mt-2">{siteInfo.address}</p>
                        </div>
                    </Card>
                    <ContactForm
                        heading={pageData.contact.heading}
                        description={pageData.contact.description}
                    />
                </div>
            </Section>
        )
    }
</BaseLayout>
