---
import {
    navigation,
    portalUrl,
    siteInfo,
    type NavId,
} from '@/data/site';
import Button from '@/components/ui/Button.astro';
import { cn } from '@/lib/cn';

interface Props {
    active?: NavId | '';
}

const { active = '' } = Astro.props;
const navId = 'site-nav';
---

<header class="relative z-50 w-full">
    <div
        class="flex flex-wrap items-center justify-between gap-4"
    >
        <a
            href="/"
            class="flex shrink-0 items-center gap-3 whitespace-nowrap"
        >
            <img
                src="/images/logo.jpg"
                alt=""
                class="h-12 w-12 rounded-[800px] object-cover"
                width="48"
                height="48"
                loading="eager"
                decoding="async"
            />
            <span class="font-display text-[32px] leading-none text-ink">
                {siteInfo.name}
            </span>
        </a>

        <nav
            id={navId}
            class="bg-cream hidden items-center gap-2 rounded-[800px] px-3 py-2 lg:flex"
            aria-label="Main"
        >
            {
                navigation.map(item => (
                    <a
                        href={item.href}
                        class={cn(
                            'rounded-[800px] px-3 py-2 text-base whitespace-nowrap transition-colors',
                            item.id === active
                                ? 'bg-ink text-white hover:text-white'
                                : 'text-ink hover:bg-paper hover:text-ink',
                        )}
                        aria-current={item.id === active ? 'page' : undefined}
                    >
                        {item.label}
                    </a>
                ))
            }
        </nav>

        <div class="hidden items-center gap-3 lg:flex">
            <Button href={portalUrl} variant="secondary" target="_blank" rel="noreferrer">
                Student portal
            </Button>
            <Button href={portalUrl} variant="primary" target="_blank" rel="noreferrer">
                Enrol for Term 3
            </Button>
        </div>

        <details class="group relative lg:hidden">
            <summary
                class="focus-ring bg-cream text-ink list-none rounded-[40px] border-[1.5px] border-ink px-4 py-2 text-base font-medium [&::-webkit-details-marker]:hidden"
                aria-label="Open menu"
            >
                <span class="group-open:hidden">Menu</span>
                <span class="hidden group-open:inline">Close</span>
            </summary>
            <div
                class="bg-cream absolute top-full right-0 left-0 mt-2 flex flex-col gap-2 rounded-[40px] border-[1.5px] border-ink p-4 shadow-lg"
            >
                {
                    navigation.map(item => (
                        <a
                            href={item.href}
                            class={cn(
                                'rounded-[800px] px-3 py-2 text-base transition-colors',
                                item.id === active
                                    ? 'bg-ink text-white hover:text-white'
                                    : 'text-ink hover:bg-paper',
                            )}
                            aria-current={item.id === active ? 'page' : undefined}
                        >
                            {item.label}
                        </a>
                    ))
                }
                <div class="mt-2 flex flex-col gap-2 border-t border-ink/20 pt-3">
                    <Button
                        href={portalUrl}
                        variant="secondary"
                        class="w-full justify-center"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Student portal
                    </Button>
                    <Button
                        href={portalUrl}
                        variant="primary"
                        class="w-full justify-center"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Enrol for Term 3
                    </Button>
                </div>
            </div>
        </details>
    </div>
</header>
