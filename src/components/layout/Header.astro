---
const navItems = [
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about' },
    { label: 'Programs', href: '/programs' },
    { label: 'Shows', href: '/shows' },
    { label: 'The Nest', href: '/the-nest' },
    { label: 'Music Theatre Camp', href: '/music-theatre-camp' },
    { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
    <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">
        <a
            href="/"
            class="flex items-center gap-2"
        >
            <img
                src="/images/logo.svg"
                alt="Pelican Productions"
                class="h-12 w-auto"
            />
        </a>

        <!-- Desktop nav -->
        <ul class="hidden items-center gap-6 lg:flex">
            {
                navItems.map(item => (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                                'hover:text-pelican-teal text-sm font-medium transition-colors',
                                currentPath === item.href
                                    ? 'text-pelican-teal'
                                    : 'text-gray-700',
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <!-- Mobile menu button -->
        <button
            type="button"
            class="rounded-md p-2 text-gray-700 lg:hidden"
            aria-label="Open menu"
            id="mobile-menu-btn"
        >
            <svg
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"
                ></path>
            </svg>
        </button>
    </nav>

    <!-- Mobile nav -->
    <div
        id="mobile-menu"
        class="hidden lg:hidden"
    >
        <ul class="space-y-1 px-4 pb-4">
            {
                navItems.map(item => (
                    <li>
                        <a
                            href={item.href}
                            class:list={[
                                'block rounded-md px-3 py-2 text-base font-medium transition-colors',
                                currentPath === item.href
                                    ? 'bg-pelican-teal/10 text-pelican-teal'
                                    : 'text-gray-700 hover:bg-gray-100',
                            ]}
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
    });
</script>
