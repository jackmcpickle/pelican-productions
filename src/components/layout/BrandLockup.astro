---
import { siteInfo } from '@/data/site';
import { cn } from '@/lib/cn';

interface Props {
    inverted?: boolean;
    class?: string;
    markClass?: string;
}

const { inverted = false, class: className, markClass }: Props = Astro.props;
---

<a
    href="/"
    class={cn('flex min-w-0 items-center gap-2 sm:gap-3', className)}
>
    <img
        src="/images/pelican.svg"
        alt=""
        class={cn('h-10 w-auto shrink-0 sm:h-12', markClass)}
        width="66"
        height="48"
        loading="eager"
        decoding="async"
    />
    <span
        class={cn(
            'font-display text-[22px] leading-none sm:text-[32px]',
            inverted ? 'text-white' : 'text-ink',
        )}
    >
        {siteInfo.name}
    </span>
</a>
