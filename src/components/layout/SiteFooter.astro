---
import {
    footerMenu,
    quickLinks,
    siteInfo,
    socialLinks,
} from '@/data/site';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Input from '@/components/ui/Input.astro';

const facebookLink = socialLinks.find(link => link.label === 'Facebook');
---

<footer class="bg-ink text-white mt-16 mb-8 flex w-full flex-col gap-12 rounded-[40px] px-6 py-10 sm:px-10 md:mt-20">
    <div class="grid items-center gap-10 md:grid-cols-2">
        <Heading
            as="h2"
            size="display"
            class="text-[clamp(2rem,8vw,80px)] leading-[1.1] text-white"
        >
            Become a VIP Pelican
        </Heading>
        <div class="flex flex-col gap-4">
            <p class="text-body m-0">
                Production news, pre-sale access and camp bookings before anyone
                else.
            </p>
            <form
                class="flex flex-col gap-3 sm:flex-row sm:items-center"
                action="#"
                method="get"
            >
                <Input
                    type="email"
                    name="email"
                    placeholder="you@email.com"
                    variant="dark"
                    class="flex-1"
                    required
                    autocomplete="email"
                />
                <Button
                    type="submit"
                    variant="primary"
                    class="hover:bg-white shrink-0 hover:text-ink"
                >
                    Subscribe
                </Button>
            </form>
        </div>
    </div>

    <div
        class="border-white-dotted flex flex-wrap items-center justify-between gap-4 border-t-[1.5px] pt-8"
    >
        <a href="/" class="flex items-center gap-3 hover:text-white">
            <img
                src="/images/logo.jpg"
                alt=""
                class="h-10 w-10 rounded-[800px] object-cover"
                width="40"
                height="40"
                loading="lazy"
            />
            <span class="font-display text-[26px] leading-none">
                {siteInfo.name}
            </span>
        </a>

        <nav class="flex flex-wrap gap-2" aria-label="Footer">
            {
                footerMenu.map(item => (
                    <a
                        href={item.href}
                        class="px-3 text-base text-white hover:text-flame"
                    >
                        {item.label}
                    </a>
                ))
            }
            {
                facebookLink && (
                    <a
                        href={facebookLink.href}
                        class="px-3 text-base text-white hover:text-flame"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Facebook
                    </a>
                )
            }
            {
                quickLinks
                    .filter(item => item.label === 'Privacy')
                    .map(item => (
                        <a
                            href={item.href}
                            class="px-3 text-base text-white hover:text-flame"
                        >
                            {item.label}
                        </a>
                    ))
            }
        </nav>

        <p class="m-0 w-full text-xs font-normal sm:w-auto sm:text-right">
            {siteInfo.nestAddress} · {siteInfo.photoCredit}
        </p>
    </div>
</footer>
