---
import { footerMenu, quickLinks, siteInfo, socialLinks } from '@/data/site';
import BrandLockup from '@/components/layout/BrandLockup.astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Input from '@/components/ui/Input.astro';

const facebookLink = socialLinks.find(link => link.label === 'Facebook');
---

<footer
    class="bg-ink mt-16 mb-8 flex w-full flex-col gap-12 rounded-[40px] px-6 py-10 text-white sm:px-10 md:mt-20"
>
    <div class="grid items-center gap-10 md:grid-cols-2">
        <Heading
            as="h2"
            size="display"
            class="text-[clamp(2rem,8vw,80px)] leading-[1.1] text-white"
        >
            Become a VIP Pelican
        </Heading>
        <div class="flex flex-col gap-4">
            <p class="text-body m-0">
                Production news, pre-sale access and camp bookings before anyone
                else.
            </p>
            <form
                class="flex flex-col gap-3 sm:flex-row sm:items-center"
                action="#"
                method="get"
            >
                <Input
                    type="email"
                    name="email"
                    placeholder="you@email.com"
                    variant="dark"
                    class="flex-1"
                    required
                    autocomplete="email"
                />
                <Button
                    type="submit"
                    variant="primary"
                    class="hover:text-ink shrink-0 hover:bg-white"
                >
                    Subscribe
                </Button>
            </form>
        </div>
    </div>

    <div
        class="border-white-dotted flex flex-wrap items-center justify-between gap-4 border-t-[1.5px] pt-8"
    >
        <BrandLockup
            inverted
            class="hover:text-white"
            markClass="h-10 w-auto sm:h-10"
        />

        <nav
            class="flex flex-wrap gap-2"
            aria-label="Footer"
        >
            {
                footerMenu.map(item => (
                    <a
                        href={item.href}
                        class="hover:text-flame px-3 text-base text-white"
                    >
                        {item.label}
                    </a>
                ))
            }
            {
                facebookLink && (
                    <a
                        href={facebookLink.href}
                        class="hover:text-flame px-3 text-base text-white"
                        target="_blank"
                        rel="noreferrer"
                    >
                        Facebook
                    </a>
                )
            }
            {
                quickLinks
                    .filter(item => item.label === 'Privacy')
                    .map(item => (
                        <a
                            href={item.href}
                            class="hover:text-flame px-3 text-base text-white"
                        >
                            {item.label}
                        </a>
                    ))
            }
        </nav>

        <p class="m-0 w-full text-xs font-normal sm:w-auto sm:text-right">
            {siteInfo.nestAddress} · {siteInfo.photoCredit}
        </p>
    </div>
</footer>
