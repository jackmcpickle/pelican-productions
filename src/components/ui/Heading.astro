---
import { cn } from '@/lib/cn';

type HeadingTag = 'h1' | 'h2' | 'h3';
type HeadingSize = 'hero' | 'display' | 'section' | 'card' | 'small';

interface Props {
    as?: HeadingTag;
    size?: HeadingSize;
    accent?: boolean;
    text?: string;
    class?: string;
}

const {
    as: Tag = 'h2',
    size = 'section',
    accent = false,
    text,
    class: className,
}: Props = Astro.props;

const sizes: Record<HeadingSize, string> = {
    hero: 'text-[clamp(3rem,12vw,189px)] leading-[0.94]',
    display: 'text-[clamp(2.5rem,8vw,96px)] leading-[0.95]',
    section: 'text-[clamp(2rem,6vw,96px)] leading-[0.95]',
    card: 'text-[clamp(1.75rem,4vw,48px)] leading-none',
    small: 'text-[clamp(1.5rem,3vw,32px)] leading-none',
};

function splitAccent(value: string): { lead: string; accent: string } {
    const trimmed = value.trim();
    const lastSpace = trimmed.lastIndexOf(' ');
    if (lastSpace === -1) {
        return { lead: '', accent: trimmed };
    }
    return {
        lead: trimmed.slice(0, lastSpace + 1),
        accent: trimmed.slice(lastSpace + 1),
    };
}

const parts = accent && text ? splitAccent(text) : null;
---

<Tag class={cn('font-display m-0 text-balance', sizes[size], className)}>
    {
        parts ? (
            <>
                {parts.lead}
                <span class="text-flame">{parts.accent}</span>
            </>
        ) : (
            <slot />
        )
    }
</Tag>
