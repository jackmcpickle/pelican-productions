---
import { cn } from '@/lib/cn';

interface Props {
    variant?: 'cream' | 'ink' | 'flame' | 'violet' | 'sun';
    padding?: boolean;
    class?: string;
}

const { variant = 'cream', padding = true, class: className } = Astro.props;

const variants = {
    cream: 'bg-cream text-ink',
    ink: 'bg-ink text-white',
    flame: 'bg-flame text-white',
    violet: 'bg-violet text-white',
    sun: 'bg-sun text-ink',
};
---

<div
    class={cn(
        'rounded-[40px]',
        variants[variant],
        padding && 'p-6 sm:p-10',
        className,
    )}
>
    <slot />
</div>
