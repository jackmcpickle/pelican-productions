---
import { cn } from '@/lib/cn';

interface Props {
    type?: 'text' | 'email' | 'tel';
    name?: string;
    id?: string;
    placeholder?: string;
    required?: boolean;
    value?: string;
    variant?: 'light' | 'dark';
    class?: string;
    autocomplete?: string;
}

const {
    type = 'text',
    name,
    id,
    placeholder,
    required,
    value,
    variant = 'light',
    class: className,
    autocomplete,
} = Astro.props;

const variants = {
    light: 'border-[1.5px] border-ink bg-cream text-ink placeholder:text-ink/50',
    dark: 'border-[1.5px] border-white bg-transparent text-white placeholder:text-white/60',
};
---

<input
    type={type}
    name={name}
    id={id}
    placeholder={placeholder}
    required={required}
    value={value}
    autocomplete={autocomplete}
    class={cn(
        'w-full rounded-[800px] px-8 py-5 text-base font-medium outline-none transition-colors focus-ring',
        variants[variant],
        className,
    )}
/>
