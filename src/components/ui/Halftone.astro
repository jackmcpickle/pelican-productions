---
import { cn } from '@/lib/cn';

interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div
    class={cn('pointer-events-none absolute inset-0', className)}
    aria-hidden="true"
>
    <div
        class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.35)_30%,transparent_32%)] [background-size:12px_12px]"
    >
    </div>
    <div
        class="absolute inset-0 bg-[radial-gradient(rgba(255,255,255,0.4)_30%,transparent_32%)] [background-size:14px_14px] [mask-image:linear-gradient(200deg,black,transparent_70%)]"
    >
    </div>
</div>
