---
import { cn } from '@/lib/cn';

interface Props {
    tone?: 'sun' | 'cream' | 'ink';
    class?: string;
}

const { tone = 'sun', class: className } = Astro.props;

const tones = {
    sun: 'bg-sun text-ink',
    cream: 'bg-cream text-ink',
    ink: 'bg-ink text-white',
};
---

<span
    class={cn(
        'inline-flex items-center rounded-[800px] px-2.5 py-1 text-sm font-medium',
        tones[tone],
        className,
    )}
>
    <slot />
</span>
