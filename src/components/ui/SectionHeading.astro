---
interface Props {
    title: string;
    subtitle?: string;
    centered?: boolean;
}

const { title, subtitle, centered = true } = Astro.props;
---

<div class:list={['mb-12', centered && 'text-center']}>
    <h2 class="text-3xl font-bold text-gray-900 md:text-4xl">{title}</h2>
    {subtitle && <p class="mt-4 text-lg text-gray-600">{subtitle}</p>}
</div>
