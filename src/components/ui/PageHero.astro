---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import { cn } from '@/lib/cn';

interface Props {
    title: string;
    subtitle?: string;
    image?: string;
    class?: string;
}

const { title, subtitle, image, class: className } = Astro.props;
---

<section class={cn('mt-12 md:mt-16', className)}>
    <Container>
        <div
            class={cn(
                'flex flex-col gap-8',
                image && 'md:grid md:grid-cols-2 md:items-center md:gap-12',
            )}
        >
            <div class="flex max-w-2xl flex-col gap-6">
                <Heading as="h1" size="display">
                    {title}
                </Heading>
                {
                    subtitle && (
                        <p class="text-body-lg m-0 max-w-xl">{subtitle}</p>
                    )
                }
            </div>
            {
                image && (
                    <MediaFrame
                        src={image}
                        alt=""
                        class="min-h-[280px] md:min-h-[360px]"
                    />
                )
            }
        </div>
    </Container>
</section>
