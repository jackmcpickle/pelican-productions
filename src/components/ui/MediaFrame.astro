---
import { cn } from '@/lib/cn';

interface Props {
    src?: string;
    alt?: string;
    class?: string;
}

const { src, alt = '', class: className } = Astro.props;
---

<div class={cn('relative overflow-hidden rounded-[40px]', className)}>
    {
        src ? (
            <img
                src={src}
                alt={alt}
                class="h-full w-full object-cover"
                loading="eager"
            />
        ) : (
            <slot name="media" />
        )
    }
    {
        Astro.slots.has('badges') && (
            <div class="absolute right-8 bottom-8 left-8 flex flex-wrap gap-2">
                <slot name="badges" />
            </div>
        )
    }
    <slot />
</div>
