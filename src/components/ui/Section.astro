---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import { cn } from '@/lib/cn';

interface Props {
    title?: string;
    subtitle?: string;
    class?: string;
    id?: string;
}

const { title, subtitle, class: className, id } = Astro.props;
---

<section id={id} class={cn('mt-16 md:mt-20', className)}>
    <Container>
        {
            (title || subtitle) && (
                <div class="mb-8 flex max-w-3xl flex-col gap-4">
                    {title && <Heading size="section">{title}</Heading>}
                    {subtitle && (
                        <p class="text-body-lg m-0 max-w-2xl">{subtitle}</p>
                    )}
                </div>
            )
        }
        <slot />
    </Container>
</section>
