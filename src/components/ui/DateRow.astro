---
import { cn } from '@/lib/cn';

interface Props {
    when: string;
    what: string;
    emphasize?: 'when' | 'what';
    class?: string | undefined;
}

const { when, what, emphasize = 'what', class: className } = Astro.props;
const title = emphasize === 'when' ? when : what;
const detail = emphasize === 'when' ? what : when;
---

<div
    class={cn(
        'border-white-dotted flex flex-col gap-2 border-t-[1.5px] pt-4',
        className,
    )}
>
    <span class="font-display text-[clamp(1.5rem,3vw,40px)] leading-none">
        {title}
    </span>
    <span class="text-sm leading-snug">{detail}</span>
</div>
