---
import { cn } from '@/lib/cn';

interface Props {
    name?: string;
    id?: string;
    placeholder?: string;
    required?: boolean;
    rows?: number;
    variant?: 'light' | 'dark';
    class?: string;
    fieldSizing?: boolean;
}

const {
    name,
    id,
    placeholder,
    required,
    rows = 4,
    variant = 'light',
    class: className,
    fieldSizing = false,
} = Astro.props;

const variants = {
    light: 'border-[1.5px] border-ink bg-cream text-ink placeholder:text-ink/50',
    dark: 'border-[1.5px] border-white bg-transparent text-white placeholder:text-white/60',
};
---

<textarea
    name={name}
    id={id}
    placeholder={placeholder}
    required={required}
    rows={rows}
    class={cn(
        'w-full rounded-[40px] px-8 py-5 text-base font-medium outline-none transition-colors focus-ring',
        fieldSizing && 'field-sizing-content min-h-[120px]',
        variants[variant],
        className,
    )}></textarea>
