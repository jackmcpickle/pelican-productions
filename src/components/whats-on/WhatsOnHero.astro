---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
---

<section class="mt-12">
    <Container>
        <div
            class="grid grid-cols-1 items-end gap-8 md:grid-cols-2 md:gap-8"
        >
            <Heading as="h1" size="hero">
                What's<br /><span class="text-flame">on</span>
            </Heading>
            <p class="text-body-lg m-0 mb-6 max-w-[480px]">
                Bookings, auditions, info nights and big announcements. Places
                go fast — 2026 camps sold out in record time, so don't sit on
                it.
            </p>
        </div>
    </Container>
</section>
