---
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import DateRow from '@/components/ui/DateRow.astro';
import Heading from '@/components/ui/Heading.astro';
import { whatsOnDates } from '@/data/whats-on';
---

<section class="mt-20">
    <Container>
        <div
            class="grid grid-cols-1 items-start gap-8 md:grid-cols-[1fr_2fr]"
        >
            <Heading as="h2" size="display">
                Key<br />dates
            </Heading>
            <Card variant="flame" class="flex flex-col">
                {
                    whatsOnDates.map((item, index) => (
                        <DateRow
                            when={item.when}
                            what={item.what}
                            class={index === 0 ? 'border-t-0' : undefined}
                        />
                    ))
                }
            </Card>
        </div>
    </Container>
</section>
