---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import { cn } from '@/lib/cn';

interface Props {
    badge: string;
    heading: string;
    headingLine: string;
    cta: string;
    href?: string;
    layout?: 'stack' | 'split';
    class?: string;
}

const {
    badge,
    heading,
    headingLine,
    cta,
    href,
    layout = 'stack',
    class: className,
} = Astro.props;

const ctaProps = href
    ? { href, variant: 'outline-light' as const }
    : { variant: 'outline-light' as const };
---

<Card
    variant="violet"
    class={cn(
        'relative overflow-hidden',
        layout === 'stack' && 'flex flex-col gap-6',
        className,
    )}
>
    <Halftone />
    {
        layout === 'stack' ? (
            <>
                <Badge class="relative self-start">{badge}</Badge>
                <Heading
                    as="h2"
                    size="display"
                    class="relative text-[clamp(2rem,6vw,80px)] leading-[1.1]"
                >
                    {heading}
                    <br />
                    {headingLine}
                </Heading>
                <div class="relative">
                    <slot />
                </div>
                <Button {...ctaProps} class="relative self-start">
                    {cta}
                </Button>
            </>
        ) : (
            <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-10">
                <div class="flex flex-col gap-6">
                    <Badge>{badge}</Badge>
                    <Heading as="h2" size="display">
                        {heading}
                        <br />
                        {headingLine}
                    </Heading>
                    <Button {...ctaProps} class="self-start">
                        {cta}
                    </Button>
                </div>
                <div class="flex flex-col gap-4 text-body">
                    <slot />
                </div>
            </div>
        )
    }
</Card>
