---
import Card from '@/components/ui/Card.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item) => (
    <Card variant="cream" class="max-w-none">
      <details>
        <summary
          class="cursor-pointer font-display text-[clamp(1.25rem,3vw,32px)] leading-none [&::-webkit-details-marker]:hidden"
        >
          {item.question}
        </summary>
        <p class="text-body mt-4 mb-0">{item.answer}</p>
      </details>
    </Card>
  ))}
</div>
