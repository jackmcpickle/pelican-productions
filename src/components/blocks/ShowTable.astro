---
import { cn } from '@/lib/cn';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';

interface ShowItem {
  name: string;
  date: string;
  link: string;
}

interface Props {
  items: ShowItem[];
}

const { items } = Astro.props;
---

<Card variant="cream" class="flex flex-col">
  {items.map((item, index) => (
    <div
      class={cn(
        'border-ink-dotted flex flex-col gap-2 border-t-[1.5px] pt-4',
        index === 0 && 'border-t-0 pt-0',
      )}
    >
      <span class="font-display text-[clamp(1.5rem,3vw,40px)] leading-none">
        {item.name}
      </span>
      <span class="text-sm leading-snug">{item.date}</span>
      <Button
        href={item.link}
        variant="secondary"
        class="mt-2 self-start"
        target="_blank"
        rel="noreferrer"
      >
        View Show
      </Button>
    </div>
  ))}
</Card>
