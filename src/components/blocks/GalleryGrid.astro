---
import MediaFrame from '@/components/ui/MediaFrame.astro';

interface GalleryItem {
  src: string;
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((item) => (
    <MediaFrame src={item.src} alt={item.alt} class="h-48" />
  ))}
</div>
