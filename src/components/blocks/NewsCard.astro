---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import type { NewsCtaVariant } from '@/data/whats-on';
import { cn } from '@/lib/cn';
import { isExternal } from '@/lib/links';

interface Props {
    tag: string;
    date: string;
    title: string;
    body: string;
    facts?: string[];
    cta: string;
    href: string;
    ctaVariant?: NewsCtaVariant;
    headingAs?: 'h2' | 'h3';
    class?: string;
}

const {
    tag,
    date,
    title,
    body,
    facts,
    cta,
    href,
    ctaVariant = 'primary',
    headingAs = 'h3',
    class: className,
} = Astro.props;

const external = isExternal(href);
---

<Card variant="cream" class={cn('flex flex-col gap-5', className)}>
    <div class="flex items-center justify-between gap-2">
        <Badge>{tag}</Badge>
        <span class="text-xs font-normal">{date}</span>
    </div>
    <Heading as={headingAs} size="card">
        {title}
    </Heading>
    <p class="text-body m-0 flex-1">{body}</p>
    {
        facts && facts.length > 0 && (
            <div class="border-ink-dotted flex flex-col gap-1.5 border-t-[1.5px] pt-4">
                {facts.map((fact) => (
                    <span class="text-sm leading-snug">{fact}</span>
                ))}
            </div>
        )
    }
    <Button
        href={href}
        variant={ctaVariant}
        class="self-start"
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
    >
        {cta}
    </Button>
</Card>
