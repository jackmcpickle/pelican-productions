---
import Card from '@/components/ui/Card.astro';

interface TestimonialItem {
  name: string;
  quote: string;
}

interface Props {
  items: TestimonialItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-6 md:grid-cols-2">
  {items.map((item) => (
    <Card variant="cream" class="flex flex-col gap-4">
      <blockquote class="text-body m-0">“{item.quote}”</blockquote>
      <figcaption class="font-display text-[clamp(1.5rem,3vw,32px)] leading-none">
        {item.name}
      </figcaption>
    </Card>
  ))}
</div>
