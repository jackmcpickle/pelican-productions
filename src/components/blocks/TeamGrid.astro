---
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';

interface Member {
  name: string;
  role: string;
  credentials?: string[];
  image: string;
}

interface TeamGroup {
  title: string;
  members: Member[];
}

interface Props {
  groups: TeamGroup[];
}

const { groups } = Astro.props;
---

<div class="space-y-10">
  {groups.map((group) => (
    <div>
      <Heading as="h3" size="small">{group.title}</Heading>
      <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {group.members.map((member) => (
          <Card variant="cream" class="text-center">
            <img
              src={member.image}
              alt={member.name}
              class="mx-auto h-40 w-40 rounded-full object-cover"
              loading="lazy"
            />
            <Heading as="h3" size="small" class="mt-4">
              {member.name}
            </Heading>
            <p class="text-sm">{member.role}</p>
            {member.credentials && (
              <ul class="text-body mt-3 space-y-1 text-sm">
                {member.credentials.map((credential) => (
                  <li>{credential}</li>
                ))}
              </ul>
            )}
          </Card>
        ))}
      </div>
    </div>
  ))}
</div>
