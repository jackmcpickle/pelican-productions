---
import Card from '@/components/ui/Card.astro';
import DateRow from '@/components/ui/DateRow.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { cn } from '@/lib/cn';

interface DateItem {
    when: string;
    what: string;
}

interface Props {
    dates: DateItem[];
    cardVariant?: 'cream' | 'flame';
    intro?: string;
    rowLayout?: 'stack' | 'split';
    emphasize?: 'when' | 'what';
    class?: string;
}

const {
    dates,
    cardVariant = 'cream',
    intro,
    rowLayout = 'stack',
    emphasize = 'what',
    class: className = '',
} = Astro.props;

const inkBorder = cardVariant === 'cream';
---

<Section class={className}>
    <div
        class="grid grid-cols-1 items-start gap-8 md:grid-cols-[1fr_2fr] md:gap-8"
    >
        <div class="flex flex-col gap-4">
            <Heading as="h2" size="display">
                Key<br />dates
            </Heading>
            {intro && <p class="text-body m-0">{intro}</p>}
        </div>
        <Card variant={cardVariant} class="flex flex-col">
            {
                dates.map((date, index) => (
                    <DateRow
                        when={date.when}
                        what={date.what}
                        emphasize={emphasize}
                        class={cn(
                            index === 0 && 'border-t-0',
                            inkBorder && 'border-ink-dotted',
                            rowLayout === 'split' && [
                                'grid grid-cols-1 gap-6 py-4 sm:grid-cols-[220px_1fr] sm:items-baseline [&>span:last-child]:text-base [&>span:last-child]:leading-[1.55]',
                                index === 0 ? 'pt-0' : 'border-t-[1.5px]',
                                index < dates.length - 1 && 'border-b-[1.5px]',
                            ],
                        )}
                    />
                ))
            }
        </Card>
    </div>
</Section>
