---
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import { pastCampPhotos } from '@/data/camps';
---

<section class="mt-16 md:mt-20">
    <Container>
        <div class="flex flex-col gap-8">
            <div
                class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end"
            >
                <Heading as="h2" size="display">Past camps</Heading>
                <p class="text-body m-0 max-w-[400px]">
                    Borne from the Directors' desire to foster up-and-coming
                    talent in the Adelaide performing arts scene. Photography
                    by Oliver Toth, Accent Photography.
                </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {
                    pastCampPhotos.map((photo) => (
                        <MediaFrame
                            src={photo.src}
                            alt={photo.alt}
                            class="h-[280px] bg-violet sm:h-[360px] [&>img]:h-full [&>img]:w-full"
                        />
                    ))
                }
            </div>
        </div>
    </Container>
</section>
