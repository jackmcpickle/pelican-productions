---
import Button from '@/components/ui/Button.astro';
---

<section class="bg-pelican-navy relative overflow-hidden py-20 lg:py-32">
    <div
        class="from-pelican-navy via-pelican-navy to-pelican-teal/20 absolute inset-0 bg-gradient-to-br"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4">
        <div class="grid items-center gap-12 lg:grid-cols-2">
            <div class="text-center lg:text-left">
                <h1
                    class="text-4xl font-bold text-white md:text-5xl lg:text-6xl"
                >
                    Lights, Camera,
                    <span class="text-pelican-gold">Action!</span>
                </h1>
                <p class="mt-6 text-lg text-gray-300 md:text-xl">
                    South Australia's premier performing arts organisation,
                    nurturing talent and inspiring creativity through music
                    theatre, dance, and drama.
                </p>
                <div
                    class="mt-8 flex flex-col gap-4 sm:flex-row sm:justify-center lg:justify-start"
                >
                    <Button
                        href="/programs"
                        size="lg"
                        >Explore Programs</Button
                    >
                    <Button
                        href="/shows"
                        variant="outline"
                        size="lg"
                    >
                        Upcoming Shows
                    </Button>
                </div>
            </div>
            <div class="relative hidden lg:block">
                <img
                    src="/images/hero/lights-camera-action.png"
                    alt="Pelican Productions performers"
                    class="rounded-2xl shadow-2xl"
                />
            </div>
        </div>
    </div>
</section>
