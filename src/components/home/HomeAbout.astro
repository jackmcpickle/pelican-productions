---
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
---

<section id="about" class="mt-16 mb-16 md:mt-20 md:mb-20">
    <Container>
        <div
            class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-16"
        >
            <Heading as="h2" size="display">
                Theatre should be fun. <span class="text-flame"
                    >And it should change you.</span
                >
            </Heading>
            <div class="flex flex-col gap-6 text-base leading-[1.55]">
                <p class="m-0">
                    Founded in 2004 by Directors Jen Frith and Kylie Green,
                    Pelican Productions creates innovative, entertaining theatre
                    that inspires young South Australians. Our teaching artists
                    are working industry professionals who build skills in
                    singing, dancing and acting — and teamwork, confidence,
                    empathy and resilience along the way.
                </p>
                <p class="m-0">
                    Everyone belongs here, regardless of race, ethnicity,
                    gender, socio-economic status, national origin, sexual
                    orientation, ability or faith. Pelican alumni have gone on
                    to SIX and Mean Girls on the West End, the Chicago US tour,
                    Sunset Boulevard and Cinderella with Opera Australia, and
                    many more.
                </p>
                <div class="flex flex-wrap gap-3">
                    <Button href="/cert4" size="lg"
                        >Cert IV Musical Theatre</Button
                    >
                    <Button href="/set-and-costume-hire" variant="secondary" size="lg"
                        >Set & costume hire</Button
                    >
                </div>
            </div>
        </div>
    </Container>
</section>
