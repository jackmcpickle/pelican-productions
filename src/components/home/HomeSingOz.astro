---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import { homeImages, sportsVoucherFormUrl } from '@/data/home';
---

<section class="mt-16 md:mt-20">
    <Container>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <Card
                variant="violet"
                class="relative flex flex-col gap-6 overflow-hidden"
            >
                <Halftone />
                <Badge class="relative self-start">Adults 18+ · No audition</Badge
                >
                <Heading
                    as="h2"
                    size="display"
                    class="relative text-[clamp(2rem,6vw,80px)] leading-[1.1]"
                >
                    Sing!OZ<br />community choir
                </Heading>
                <p class="text-body relative m-0 max-w-[460px]">
                    Your midweek reset. Tuesdays 7–9pm at Lower Mitcham.
                    Harmony, technique, a cracking repertoire, and a final
                    concert with a live band at Norwood Concert Hall on 24
                    October. Sing louder. Feel better. Belong.
                </p>
                <Button variant="outline-light" class="relative self-start">
                    2026 program filled — join the 2027 waitlist
                </Button>
            </Card>

            <Card variant="cream" class="flex flex-col justify-between gap-6">
                <div class="flex flex-col gap-4">
                    <Badge class="self-start">Save on fees</Badge>
                    <Heading
                        as="h2"
                        size="display"
                        class="text-[clamp(2rem,5vw,64px)] leading-none"
                    >
                        We're a Sports Vouchers Plus provider
                    </Heading>
                    <p class="text-body m-0">
                        Children in Reception to Year 9 receive 2 × $100
                        vouchers per calendar year. Every Pelican program is
                        eligible.
                    </p>
                </div>
                <div class="overflow-hidden rounded-[20px] bg-paper">
                    <img
                        src={homeImages.sportsVouchers}
                        alt="Sports Vouchers Plus"
                        class="h-[120px] w-full object-cover"
                        loading="lazy"
                    />
                </div>
                <Button
                    href={sportsVoucherFormUrl}
                    variant="secondary"
                    class="self-start"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Download voucher form
                </Button>
            </Card>
        </div>
    </Container>
</section>
