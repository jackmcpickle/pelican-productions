---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import DateRow from '@/components/ui/DateRow.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import {
    cert4AuditionPieces,
    cert4AuditionUrl,
    cert4Dates,
} from '@/data/cert4';
---

<Section>
    <Card variant="ink" class="relative overflow-hidden">
        <Halftone />
        <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-16">
            <div class="flex flex-col gap-6">
                <Badge>2027 intake</Badge>
                <Heading as="h2" size="display" class="text-white">
                    How to audition
                </Heading>
                <p class="text-body m-0 text-white">
                    Submit an online audition video. Full instructions sit on
                    page 23 of the course prospectus.
                </p>
                <div class="flex flex-col">
                    {
                        cert4Dates.map((date) => (
                            <DateRow when={date.when} what={date.what} />
                        ))
                    }
                </div>
                <Button
                    href={cert4AuditionUrl}
                    variant="outline-light"
                    class="self-start"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Submit your audition
                </Button>
            </div>
            <div class="flex flex-col gap-4">
                {
                    cert4AuditionPieces.map((piece) => (
                        <Card variant="cream" class="flex flex-col gap-3 p-6">
                            <Heading as="h3" size="small">
                                {piece.title}
                            </Heading>
                            <p class="text-body m-0">{piece.detail}</p>
                            {piece.href && piece.cta && (
                                <Button
                                    href={piece.href}
                                    variant="secondary"
                                    class="self-start"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    {piece.cta}
                                </Button>
                            )}
                        </Card>
                    ))
                }
            </div>
        </div>
    </Card>
</Section>
