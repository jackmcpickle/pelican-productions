---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import {
    cert4AuditionUrl,
    cert4ProspectusUrl,
} from '@/data/cert4';
---

<Section class="mt-12 md:mt-16">
    <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
        <div class="flex flex-col gap-6">
            <Badge>Auditions extended to 30 August</Badge>
            <Heading as="h1" size="hero" class="md:text-[80px]">
                Cert IV Musical Theatre
            </Heading>
            <p class="text-body m-0">CUA40520 · with Empowerdance RTO 40397</p>
        </div>
        <div class="flex flex-col gap-6 text-body">
            <p class="m-0">
                For the first time in South Australia, aspiring musical theatre
                performers can enrol in the CUA40520 Certificate IV in Musical
                Theatre through Pelican. One academic year at The Nest, led by
                Jen Frith and Kylie Green.
            </p>
            <p class="m-0">
                Built for students in Years 10–13 who want serious training in
                singing, acting and dance, plus an audition portfolio and the
                credits to match.
            </p>
            <div class="flex flex-wrap gap-3">
                <Button
                    href={cert4AuditionUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Submit your audition
                </Button>
                <Button
                    href={cert4ProspectusUrl}
                    variant="secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Course prospectus
                </Button>
            </div>
        </div>
    </div>
</Section>
