---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Halftone from '@/components/ui/Halftone.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { diplomaInterestUrl } from '@/data/cert4';
---

<Section>
    <Card variant="violet" class="relative overflow-hidden">
        <Halftone />
        <div class="relative grid items-start gap-10 md:grid-cols-2 md:gap-16">
            <div class="flex flex-col gap-6">
                <Badge>Launching 2027</Badge>
                <Heading as="h2" size="display" class="text-white">
                    Diploma of Musical Theatre
                </Heading>
            </div>
            <div class="flex flex-col gap-6 text-body">
                <p class="m-0">
                    CUA50220, also with Empowerdance RTO 40397. Full-time
                    professional training, Tuesday to Friday, for post-school
                    performers. More information coming soon.
                </p>
                <Button
                    href={diplomaInterestUrl}
                    variant="outline-light"
                    class="self-start"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Register your interest
                </Button>
            </div>
        </div>
    </Card>
</Section>
