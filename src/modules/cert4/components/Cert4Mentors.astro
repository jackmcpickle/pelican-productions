---
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { cert4Mentors } from '@/data/cert4';
---

<Section>
    <Heading as="h2" size="display" class="mb-8">Meet your mentors</Heading>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
            cert4Mentors.map((mentor) => (
                <Card variant="cream" class="flex flex-col gap-3">
                    <Heading as="h3" size="card">
                        {mentor.name}
                    </Heading>
                    <span class="text-sm leading-snug">{mentor.credit}</span>
                </Card>
            ))
        }
    </div>
</Section>
