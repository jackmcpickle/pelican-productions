---
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { aboutDirectors } from '@/data/about';
---

<Section>
    <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-2 md:gap-16">
        <Heading size="display">The directors</Heading>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
                aboutDirectors.map((director) => (
                    <Card variant="cream" class="flex flex-col gap-4">
                        <div
                            class="flex h-[120px] w-[120px] items-center justify-center rounded-full bg-[repeating-linear-gradient(45deg,var(--color-paper)_0_8px,var(--color-cream)_8px_16px)] font-mono text-[11px] text-ink"
                            aria-hidden="true"
                        >
                            photo
                        </div>
                        <Heading as="h3" size="card">
                            {director.name}
                        </Heading>
                        <span class="text-sm">{director.role}</span>
                    </Card>
                ))
            }
        </div>
    </div>
</Section>
