---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { facebookUrl } from '@/data/site';
---

<Section>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <Card variant="flame" class="flex flex-col gap-6">
            <Badge tone="sun" class="self-start">Accredited training</Badge>
            <Heading
                as="h2"
                size="small"
                class="!text-[clamp(2rem,5vw,64px)] leading-none tracking-[0.02em]"
            >
                Cert IV & Diploma of Musical Theatre
            </Heading>
            <p class="text-body m-0">
                Professional post-school training in partnership with
                Empowerdance PTY LTD RTO 40397. Cert IV auditions open for 2027;
                the Diploma launches 2027.
            </p>
            <Button href="/cert4" variant="inverse" class="self-start">
                Audition info
            </Button>
        </Card>
        <Card variant="cream" class="flex flex-col gap-6">
            <Badge tone="sun" class="self-start">Get in touch</Badge>
            <Heading
                as="h2"
                size="small"
                class="!text-[clamp(2rem,5vw,64px)] leading-none tracking-[0.02em]"
            >
                Come say hi at The Nest
            </Heading>
            <div class="text-body flex flex-col gap-2">
                <span>57A Price Avenue, Mitcham SA</span>
                <span>
                    Join 'The Pelican Collective' Facebook group for all the
                    latest news.
                </span>
            </div>
            <div class="flex flex-wrap gap-3">
                <Button href="/contact">Contact us</Button>
                <Button
                    href={facebookUrl}
                    variant="secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Facebook
                </Button>
            </div>
        </Card>
    </div>
</Section>
