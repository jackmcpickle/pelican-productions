---
import NewsCard from '@/components/blocks/NewsCard.astro';
import Section from '@/components/ui/Section.astro';
import { getNews } from '@/lib/news';

const whatsOnNews = await getNews();
---

<Section>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {
            whatsOnNews.map((item) => (
                <NewsCard
                    tag={item.data.tag}
                    date={item.data.dateLabel}
                    title={item.data.title}
                    body={item.data.body}
                    facts={item.data.facts}
                    cta={item.data.cta}
                    href={item.data.href}
                    ctaVariant={item.data.ctaVariant}
                    headingAs="h2"
                />
            ))
        }
    </div>
</Section>
