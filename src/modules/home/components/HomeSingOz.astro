---
import SingOzCard from '@/components/blocks/SingOzCard.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { homeImages, sportsVoucherFormUrl } from '@/data/home';
---

<Section>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
        <SingOzCard
            badge="Adults 18+ · No audition"
            heading="Sing!OZ"
            headingLine="community choir"
            cta="2026 program filled — join the 2027 waitlist"
        >
            <p class="text-body m-0 max-w-[460px]">
                Your midweek reset. Tuesdays 7–9pm at Lower Mitcham. Harmony,
                technique, a cracking repertoire, and a final concert with a
                live band at Norwood Concert Hall on 24 October. Sing louder.
                Feel better. Belong.
            </p>
        </SingOzCard>

        <Card variant="cream" class="flex flex-col justify-between gap-6">
            <div class="flex flex-col gap-4">
                <Badge class="self-start">Save on fees</Badge>
                <Heading
                    as="h2"
                    size="display"
                    class="text-[clamp(2rem,5vw,64px)] leading-none"
                >
                    We're a Sports Vouchers Plus provider
                </Heading>
                <p class="text-body m-0">
                    Children in Reception to Year 9 receive 2 × $100 vouchers
                    per calendar year. Every Pelican program is eligible.
                </p>
            </div>
            <div class="overflow-hidden rounded-[20px] bg-paper">
                <img
                    src={homeImages.sportsVouchers}
                    alt="Sports Vouchers Plus"
                    class="h-[120px] w-full object-cover"
                    loading="lazy"
                />
            </div>
            <Button
                href={sportsVoucherFormUrl}
                variant="secondary"
                class="self-start"
                target="_blank"
                rel="noopener noreferrer"
            >
                Download voucher form
            </Button>
        </Card>
    </div>
</Section>
