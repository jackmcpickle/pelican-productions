---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import Section from '@/components/ui/Section.astro';
import { homeImages } from '@/data/home';
import {
    getFeaturedProductions,
    getProductionHref,
} from '@/lib/productions';

const shows = await getFeaturedProductions();
---

<Section id="musicals">
    <div class="flex flex-col gap-8">
        <div
            class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end"
        >
            <Heading as="h2" size="section">The shows</Heading>
            <Button href="/musicals" variant="secondary">Every production</Button
            >
        </div>

        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[2fr_1fr]">
            <a
                href="/musicals/in-the-heights"
                data-quiet
                class="focus-ring block rounded-[40px]"
            >
                <MediaFrame
                    src={homeImages.inTheHeights}
                    alt="In the Heights, 2019"
                    class="min-h-[280px] lg:min-h-[440px]"
                >
                    <div slot="badges" class="flex gap-2">
                        <Badge>2019</Badge>
                        <Badge tone="cream">In the Heights</Badge>
                    </div>
                </MediaFrame>
            </a>
            <MediaFrame
                src={homeImages.musicalProduction}
                alt="Pelican musical production"
                class="min-h-[280px] lg:min-h-[440px]"
            >
                <div slot="badges" class="flex gap-2">
                    <Badge tone="cream">On stage</Badge>
                </div>
            </MediaFrame>
        </div>

        <Card variant="cream" padding={false} class="flex flex-wrap items-center">
            {
                shows.map((show, index) => {
                    const href = getProductionHref(show);
                    const classes = [
                        'flex items-baseline gap-2.5 px-6 py-2',
                        index < shows.length - 1 &&
                            'border-ink-dotted border-r-[1.5px]',
                    ];
                    const label = (
                        <>
                            <span class="text-xs font-normal">
                                {show.data.year}
                            </span>
                            <span class="font-display text-[32px] leading-none">
                                {show.data.name}
                            </span>
                        </>
                    );

                    return href ? (
                        <a href={href} data-quiet class:list={classes}>
                            {label}
                        </a>
                    ) : (
                        <div class:list={classes}>{label}</div>
                    );
                })
            }
        </Card>
    </div>
</Section>
