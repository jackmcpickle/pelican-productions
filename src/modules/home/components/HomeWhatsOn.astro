---
import NewsCard from '@/components/blocks/NewsCard.astro';
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { newsItems } from '@/data/home';
---

<Section id="whats-on">
    <div class="flex flex-col gap-8">
        <div
            class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end"
        >
            <Heading as="h2" size="section">What's on</Heading>
            <Button href="/whats-on" variant="secondary"
                >All announcements</Button
            >
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
            {
                newsItems.map((item) => (
                    <NewsCard
                        tag={item.tag}
                        date={item.date}
                        title={item.title}
                        body={item.body}
                        cta={item.cta}
                        href={item.href}
                        headingAs="h3"
                        class="min-h-[340px]"
                    />
                ))
            }
        </div>
    </div>
</Section>
