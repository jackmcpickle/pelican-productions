---
import Badge from '@/components/ui/Badge.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { nestHeroImage } from '@/data/nest';
---

<Section class="mt-12 md:mt-16">
    <div class="bg-ink overflow-hidden rounded-[40px]">
        <div class="px-6 pt-8 sm:px-10 sm:pt-10">
            <div
                class="flex h-[220px] items-center justify-center overflow-hidden sm:h-[280px]"
            >
                <img
                    src={nestHeroImage}
                    alt=""
                    class="h-full w-auto max-w-none object-cover"
                    loading="eager"
                />
            </div>
        </div>
        <div
            class="flex flex-col gap-6 px-6 pt-8 pb-8 sm:px-10 sm:pt-10 sm:pb-12 md:flex-row md:items-end md:justify-between"
        >
            <div class="flex flex-col gap-4">
                <Badge>Weekly classes · Term 3, 2026 enrolling</Badge>
                <Heading as="h1" size="hero" class="text-white">
                    The Nest
                </Heading>
            </div>
            <p class="m-0 text-base leading-snug text-white md:text-right">
                57A Price Avenue<br />Mitcham SA
            </p>
        </div>
    </div>
</Section>
