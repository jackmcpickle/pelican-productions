---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { nestPrograms } from '@/data/nest';
import { portalUrl } from '@/data/site';
---

<Section class="mt-20 md:mt-24">
    <div class="flex flex-col gap-4">
        {
            nestPrograms.map((program) => (
                <Card variant="cream">
                    <div class="grid items-start gap-8 md:grid-cols-[1fr_1.4fr] md:gap-10">
                        <div class="flex flex-col gap-4">
                            <Badge tone="sun" class="self-start text-xs">
                                {program.ages}
                            </Badge>
                            <Heading as="h3" size="card" class="md:text-[64px]">
                                {program.name}
                            </Heading>
                            <div class="flex flex-col gap-1">
                                {program.times.map((time) => (
                                    <span class="text-sm leading-snug">
                                        {time}
                                    </span>
                                ))}
                            </div>
                        </div>
                        <div class="flex flex-col gap-5 text-body">
                            <p class="m-0">{program.blurb}</p>
                            <p class="m-0">{program.more}</p>
                            <Button href={portalUrl} class="self-start">
                                {program.cta}
                            </Button>
                        </div>
                    </div>
                </Card>
            ))
        }
    </div>
</Section>
