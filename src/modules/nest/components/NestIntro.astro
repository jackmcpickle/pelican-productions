---
import Button from '@/components/ui/Button.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { portalUrl } from '@/data/site';
---

<Section>
    <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
        <Heading as="h2" size="section" class="leading-[1.1] md:text-[80px]">
            A class for every kind of performer
        </Heading>
        <div class="flex flex-col gap-6 text-body">
            <p class="m-0">
                Whether you're building skills towards a professional career in
                the performing arts or simply want lots of fun with friends in
                an inclusive, inspiring environment, we've got you. The Nest is
                home to a dedicated Music Theatre Academy, SMASH dance, acting
                classes, private vocal lessons and our adult community choir.
            </p>
            <p class="m-0">
                Tutors are working industry professionals. Sports Vouchers Plus
                are accepted on every program.
            </p>
            <Button href={portalUrl} class="self-start">
                Register for Term 3, 2026
            </Button>
        </div>
    </div>
</Section>
