---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import type { Camp } from '@/data/camps';
import { campsBookingUrl } from '@/data/camps';
import { cn } from '@/lib/cn';

interface Props {
    camp: Camp;
}

const { camp } = Astro.props;
---

<Card
    variant={camp.variant}
    class={cn(camp.variant === 'flame' && 'text-ink')}
>
    <article class="flex flex-col gap-6">
        <Badge>{camp.length}</Badge>
        <Heading as="h2" class="text-[clamp(2rem,5vw,80px)] leading-[1.1]">
            {camp.name}
        </Heading>
        <p class="text-body m-0">{camp.blurb}</p>
        <div class="grid grid-cols-2 gap-4">
            {
                camp.facts.map((fact) => (
                    <div class="flex flex-col gap-1 border-t-[1.5px] border-current border-dotted pt-3">
                        <span class="text-xs font-normal">{fact.label}</span>
                        <span class="font-display text-[clamp(1.25rem,3vw,32px)] leading-none">
                            {fact.value}
                        </span>
                    </div>
                ))
            }
        </div>
        <Button
            href={campsBookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant={camp.buttonVariant}
            size="lg"
            class="self-start"
        >
            Book now
        </Button>
    </article>
</Card>
