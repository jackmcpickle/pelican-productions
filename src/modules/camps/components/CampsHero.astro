---
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Heading from '@/components/ui/Heading.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import { campsBookingUrl, campsHeroImage } from '@/data/camps';
---

<section class="mt-12 md:mt-16">
    <Container>
        <div
            class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-2 lg:gap-8"
        >
            <div class="flex flex-col justify-between gap-10">
                <div class="flex flex-col gap-6">
                    <Badge>January school holidays · Bookings open</Badge>
                    <Heading as="h1" size="hero">
                        Summer.<br /><span class="text-flame">Sorted.</span>
                    </Heading>
                </div>
                <div class="flex max-w-[520px] flex-col gap-6">
                    <p class="text-body-lg m-0">
                        Music Theatre Camp and Spotlight take the best of
                        Broadway and the West End and turn it into a fully
                        staged extravaganza in two weeks flat. Don't be fooled
                        by the age of the cast — it is a show not to be missed.
                    </p>
                    <Button
                        href={campsBookingUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        size="lg"
                        class="self-start"
                    >
                        Book MTC / Spotlight 2027
                    </Button>
                </div>
            </div>
            <MediaFrame
                src={campsHeroImage}
                alt="Music Theatre Camp finale"
                class="relative min-h-[360px] bg-violet lg:min-h-[560px] [&>img]:absolute [&>img]:inset-0 [&>img]:h-full [&>img]:w-full"
            >
                <div class="absolute bottom-8 left-8">
                    <Badge>MTC 2023 finale · Photo: Oliver Toth</Badge>
                </div>
            </MediaFrame>
        </div>
    </Container>
</section>
