---
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';

interface Review {
    quote: string;
    attribution: string;
}

interface Props {
    items: Review[];
}

const { items } = Astro.props;
---

<Section>
    <div class="flex flex-col gap-8">
        <Heading size="display">Reviews</Heading>
        <div class="grid gap-4 md:grid-cols-2">
            {
                items.map((item) => (
                    <Card variant="cream" class="flex flex-col gap-6">
                        <blockquote class="text-body-lg m-0">
                            {item.quote}
                        </blockquote>
                        <p class="font-display m-0 text-[clamp(1.5rem,3vw,32px)] leading-none">
                            {item.attribution}
                        </p>
                    </Card>
                ))
            }
        </div>
    </div>
</Section>
