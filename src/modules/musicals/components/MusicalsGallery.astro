---
import Badge from '@/components/ui/Badge.astro';
import MediaFrame from '@/components/ui/MediaFrame.astro';
import Section from '@/components/ui/Section.astro';
import { musicalsImages } from '@/data/musicals';
---

<Section>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-[2fr_1fr]">
        <a
            href="/musicals/in-the-heights"
            data-quiet
            class="focus-ring block rounded-[40px]"
        >
            <MediaFrame
                src={musicalsImages.inTheHeights}
                alt="In the Heights"
                class="min-h-[320px] md:min-h-[520px]"
            >
                <Badge slot="badges" tone="sun">2019</Badge>
                <Badge slot="badges" tone="cream">In the Heights</Badge>
            </MediaFrame>
        </a>
        <MediaFrame
            src={musicalsImages.onStage}
            alt="On stage"
            class="min-h-[320px] md:min-h-[520px]"
        >
            <Badge slot="badges" tone="cream">On stage</Badge>
        </MediaFrame>
    </div>
</Section>
