---
import Card from '@/components/ui/Card.astro';
import Heading from '@/components/ui/Heading.astro';
import Section from '@/components/ui/Section.astro';
import { musicalsCredits } from '@/data/musicals';
---

<Section class="mt-20 md:mt-20">
    <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-2 md:gap-16">
        <div class="flex flex-col gap-6">
            <Heading size="display">
                From The Nest to the <span class="text-flame">West End</span>
            </Heading>
            <p class="text-body m-0">
                Pelican has prepared and represented talent for professional
                musical theatre and film for years. Pelican performers and
                alumni have been cast in:
            </p>
        </div>
        <Card variant="cream" class="flex flex-wrap gap-2 !p-10">
            {
                musicalsCredits.map((credit) => (
                    <span class="rounded-[800px] bg-paper px-3.5 py-2 text-sm">
                        {credit}
                    </span>
                ))
            }
        </Card>
    </div>
</Section>
